@model List<ProyectoPograAvanzada.Models.CarritoItem>
@{
    ViewBag.Title = "Carrito de Compras";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-primary bg-gradient text-white p-4">
                    <h2 class="text-center mb-0">
                        <i class="fas fa-shopping-cart me-2"></i>Carrito de Compras
                    </h2>
                </div>

                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Error:</strong> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>Éxito:</strong> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (Model.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover border rounded-3 overflow-hidden shadow-sm">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th class="py-3">Producto</th>
                                        <th class="py-3">Precio</th>
                                        <th class="py-3">Cantidad</th>
                                        <th class="py-3">Total</th>
                                        <th class="py-3">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="align-middle py-3">@item.Nombre</td>
                                            <td class="align-middle py-3">$@item.Precio.ToString("N2")</td>
                                            <td class="align-middle py-3">
                                                <form action="@Url.Action("ActualizarCantidad", "Carrito")" method="post" class="d-flex align-items-center">
                                                    <input type="hidden" name="productoId" value="@item.ProductoId" />
                                                    <input type="number" name="cantidad" value="@item.Cantidad" min="1" class="form-control form-control-sm" style="width: 70px;" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary ms-2">
                                                        <i class="fas fa-sync-alt"></i>
                                                    </button>
                                                </form>
                                            </td>
                                            <td class="align-middle py-3 fw-bold">$@item.Total.ToString("N2")</td>
                                            <td class="align-middle py-3">
                                                @Html.ActionLink("Eliminar", "EliminarDeCarrito", new { id = item.ProductoId },
                                                new { @class = "btn btn-danger btn-sm shadow-sm rounded-pill px-3" })
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-light">
                                    <tr>
                                        <td colspan="3" class="text-end py-3"><strong>Total:</strong></td>
                                        <td colspan="2" class="py-3 fw-bold fs-5 text-primary">
                                            $@Model.Sum(item => item.Total).ToString("N2")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="d-flex justify-content-center mt-4">
                            @Html.ActionLink("Proceder con el Pedido", "Pedido", null,
                            new { @class = "btn btn-lg btn-primary px-5 shadow rounded-pill" })
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="display-1 text-muted mb-4">
                                <i class="fas fa-cart-arrow-down"></i>
                            </div>
                            <h3 class="mb-3">Tu carrito está vacío</h3>
                            <p class="text-muted mb-4">¡Explora nuestra colección y agrega productos!</p>
                            @Html.ActionLink("Explorar Productos", "Index", "Productoes", null,
                            new { @class = "btn btn-lg btn-primary px-5 shadow rounded-pill" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>