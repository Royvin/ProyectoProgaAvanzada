@model IEnumerable<ProyectoPograAvanzada.Models.Producto>
@{
    ViewBag.Title = "Listado de Productos";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-primary bg-gradient text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="mb-0">
                            <i class="fas fa-boxes me-2"></i>Listado de Productos
                        </h2>
                        <a href="@Url.Action("Create", "Productoes")" class="btn btn-light btn-lg px-4 shadow-sm">
                            <i class="fas fa-plus-circle me-2"></i>Crear Nuevo
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-success rounded-3 shadow-sm mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    <i class="fas fa-check-circle fa-2x"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0">¡Operación Exitosa!</h5>
                                    <p class="mb-0">@TempData["Message"]</p>
                                </div>
                                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-primary bg-opacity-10 text-primary">
                                <tr>
                                    <th class="py-3">@Html.DisplayNameFor(model => model.Nombre)</th>
                                    <th class="py-3">@Html.DisplayNameFor(model => model.Precio)</th>
                                    <th class="py-3">@Html.DisplayNameFor(model => model.CantidadaDisponible)</th>
                                    <th class="py-3 text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="border-bottom">
                                        <td class="py-3 fw-bold">@Html.DisplayFor(modelItem => item.Nombre)</td>
                                        <td class="py-3">₡@Html.DisplayFor(modelItem => item.Precio)</td>
                                        <td class="py-3">
                                            <span class="badge bg-primary rounded-pill">
                                                @Html.DisplayFor(modelItem => item.CantidadaDisponible) unidades
                                            </span>
                                        </td>
                                        <td class="py-3 text-center">
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("Edit", "Productoes", new { id = item.IdProducto })" class="btn btn-warning btn-sm">
                                                    <i class="fas fa-edit me-1"></i>Editar
                                                </a>
                                                <a href="@Url.Action("Details", "Productoes", new { id = item.IdProducto })" class="btn btn-primary btn-sm">
                                                    <i class="fas fa-info-circle me-1"></i>Detalles
                                                </a>
                                                <a href="@Url.Action("Delete", "Productoes", new { id = item.IdProducto })" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash-alt me-1"></i>Eliminar
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No hay productos disponibles</h4>
                            <p class="text-muted">Comience creando un nuevo producto</p>
                            <a href="@Url.Action("Create", "Productoes")" class="btn btn-primary mt-3">
                                <i class="fas fa-plus-circle me-2"></i>Crear Producto
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>