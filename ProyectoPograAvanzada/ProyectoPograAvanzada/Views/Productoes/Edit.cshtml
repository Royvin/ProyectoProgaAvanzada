@model ProyectoPograAvanzada.Models.Producto
@{
    ViewBag.Title = "Editar Producto";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-warning bg-gradient text-white p-4">
                    <h2 class="text-center mb-0">
                        <i class="fas fa-edit me-2"></i>Editar Producto
                    </h2>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm("Edit", "Productoes", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3" })
                        @Html.HiddenFor(model => model.IdProducto)

                        <div class="card shadow-sm rounded-3 mb-4 border-warning border-top border-0 border-2">
                            <div class="card-header bg-warning bg-opacity-10 py-3">
                                <h4 class="mb-0 text-warning">
                                    <i class="fas fa-info-circle me-2"></i>Detalles del Producto
                                </h4>
                            </div>
                            <div class="card-body p-4">
                                <div class="mb-4">
                                    @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "form-label fw-bold" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-warning text-white border-warning">
                                            <i class="fas fa-book"></i>
                                        </span>
                                        @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control border-warning", placeholder = "Nombre del producto" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-4">
                                    @Html.LabelFor(model => model.Precio, htmlAttributes: new { @class = "form-label fw-bold" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-warning text-white border-warning">
                                            <i class="fas fa-colon-sign"></i>
                                        </span>
                                        @Html.EditorFor(model => model.Precio, new { htmlAttributes = new { @class = "form-control border-warning", placeholder = "Precio del producto" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-4">
                                    @Html.LabelFor(model => model.CantidadaDisponible, htmlAttributes: new { @class = "form-label fw-bold" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-warning text-white border-warning">
                                            <i class="fas fa-boxes"></i>
                                        </span>
                                        @Html.EditorFor(model => model.CantidadaDisponible, new { htmlAttributes = new { @class = "form-control border-warning", placeholder = "Cantidad disponible" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.CantidadaDisponible, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-4">
                                    @Html.LabelFor(model => model.Imagen, htmlAttributes: new { @class = "form-label fw-bold" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-warning text-white border-warning">
                                            <i class="fas fa-image"></i>
                                        </span>
                                        <input type="file" name="Imagen" id="Imagen" class="form-control border-warning" />
                                    </div>
                                    <small class="text-muted">Seleccione una nueva imagen para el producto (opcional)</small>
                                </div>

                                @if (Model.Imagen != null && Model.Imagen.Length > 0)
                                {
                                    <div class="text-center mt-3">
                                        <p class="mb-2 fw-bold">Imagen actual:</p>
                                        @{
                                            string imageBase64 = Convert.ToBase64String(Model.Imagen);
                                            string imageSrc = string.Format("data:image/jpg;base64, {0}", imageBase64);
                                        }
                                        <img src="@imageSrc" alt="Imagen actual del producto" class="img-fluid rounded shadow" style="max-height: 150px;" />
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="text-center mt-4 d-flex gap-3 justify-content-center">
                            <button type="submit" class="btn btn-warning btn-lg px-5 shadow">
                                <i class="fas fa-save me-2"></i>Guardar Cambios
                            </button>
                            @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary btn-lg px-4" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}