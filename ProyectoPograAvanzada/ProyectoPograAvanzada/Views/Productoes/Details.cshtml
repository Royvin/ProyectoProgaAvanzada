@model ProyectoPograAvanzada.Models.Producto
@{
    ViewBag.Title = "Detalles del Producto";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-primary bg-gradient text-white p-4">
                    <h2 class="text-center mb-0">
                        <i class="fas fa-info-circle me-2"></i>Detalles del Producto
                    </h2>
                </div>

                <div class="card-body p-4">
                    <div class="card shadow-sm rounded-3 mb-4 border-primary border-top border-0 border-2">
                        <div class="card-header bg-primary bg-opacity-10 py-3">
                            <h4 class="mb-0 text-primary">
                                <i class="fas fa-box-open me-2"></i>Información del Producto
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-6 fw-bold text-primary">
                                            @Html.DisplayNameFor(model => model.Nombre)
                                        </dt>
                                        <dd class="col-sm-6">
                                            @Html.DisplayFor(model => model.Nombre)
                                        </dd>
                                        <dt class="col-sm-6 fw-bold text-primary">
                                            @Html.DisplayNameFor(model => model.Precio)
                                        </dt>
                                        <dd class="col-sm-6">
                                            @Html.DisplayFor(model => model.Precio)
                                        </dd>
                                        <dt class="col-sm-6 fw-bold text-primary">
                                            @Html.DisplayNameFor(model => model.CantidadaDisponible)
                                        </dt>
                                        <dd class="col-sm-6">
                                            @Html.DisplayFor(model => model.CantidadaDisponible)
                                        </dd>
                                    </dl>
                                </div>
                                <div class="col-md-6 text-center">
                                    @if (Model.Imagen != null && Model.Imagen.Length > 0)
                                    {
                                        string imageBase64 = Convert.ToBase64String(Model.Imagen);
                                        string imageSrc = string.Format("data:image/jpg;base64, {0}", imageBase64);
                                        <img src="@imageSrc" alt="Imagen del producto" class="img-fluid rounded shadow" style="max-height: 200px;" />
                                    }
                                    else
                                    {
                                        <div class="alert alert-secondary rounded-3 h-100 d-flex flex-column justify-content-center align-items-center">
                                            <i class="fas fa-image fa-3x mb-3 text-muted"></i>
                                            <p class="mb-0 text-muted">No hay imagen disponible</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm rounded-3 mb-4 border-primary border-top border-0 border-2">
                        <div class="card-header bg-primary bg-opacity-10 py-3">
                            <h4 class="mb-0 text-primary">
                                <i class="fas fa-star me-2"></i>Reseñas del Producto
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            @if (Model.Reseñas != null && Model.Reseñas.Any())
                            {
                                <div class="list-group">
                                    @foreach (var reseña in Model.Reseñas)
                                    {
                                        <div class="list-group-item border-primary border-start border-0 border-3 mb-3 shadow-sm rounded-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h5 class="fw-bold text-primary mb-2">@reseña.Titulo</h5>
                                                <div>
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="fas fa-star @(i <= reseña.Calificacion ? "text-warning" : "text-muted")"></i>
                                                    }
                                                </div>
                                            </div>
                                            <p class="mb-2">@reseña.Descripcion</p>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">@reseña.FechaCreacion.ToString("dd/MM/yyyy")</small>
                                                @Html.ActionLink("Eliminar", "Delete", "Reseñas", new { id = reseña.IdReseña }, new { @class = "btn btn-danger btn-sm" })
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info rounded-3 text-center">
                                    <i class="fas fa-comment-slash fa-2x mb-3"></i>
                                    <p class="mb-0">Aún no hay reseñas para este producto.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="text-center mt-4 d-flex gap-3 justify-content-center">
                        @Html.ActionLink("Editar", "Edit", new { id = Model.IdProducto }, new { @class = "btn btn-warning btn-lg px-5 shadow" })
                        @Html.ActionLink("Volver a la lista", "Index", "Home", null, new { @class = "btn btn-outline-secondary btn-lg px-4" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>