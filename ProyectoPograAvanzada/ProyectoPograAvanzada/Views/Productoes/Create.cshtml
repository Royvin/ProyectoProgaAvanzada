@model ProyectoPograAvanzada.Models.Producto
@{
    ViewBag.Title = "Crear Producto";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-primary bg-gradient text-white p-4">
                    <h2 class="text-center mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Crear Producto
                    </h2>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm("Create", "Productoes", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3" })

                        <div class="card shadow-sm rounded-3 mb-4 border-primary border-top border-0 border-2">
                            <div class="card-header bg-primary bg-opacity-10 py-3">
                                <h4 class="mb-0 text-primary">
                                    <i class="fas fa-info-circle me-2"></i>Detalles del Producto
                                </h4>
                            </div>
                            <div class="card-body p-4">
                                <div class="mb-4">
                                    @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "form-label fw-bold" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white border-primary">
                                            <i class="fas fa-book"></i>
                                        </span>
                                        @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control border-primary", placeholder = "Nombre del producto" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-4">
                                    @Html.LabelFor(model => model.Precio, htmlAttributes: new { @class = "form-label fw-bold" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white border-primary">
                                            <i class="fas fa-colon-sign"></i>
                                        </span>
                                        @Html.EditorFor(model => model.Precio, new { htmlAttributes = new { @class = "form-control border-primary", placeholder = "Precio del producto" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-4">
                                    @Html.LabelFor(model => model.CantidadaDisponible, htmlAttributes: new { @class = "form-label fw-bold" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white border-primary">
                                            <i class="fas fa-boxes"></i>
                                        </span>
                                        @Html.EditorFor(model => model.CantidadaDisponible, new { htmlAttributes = new { @class = "form-control border-primary", placeholder = "Cantidad disponible" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.CantidadaDisponible, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-4">
                                    @Html.LabelFor(model => model.Imagen, htmlAttributes: new { @class = "form-label fw-bold" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white border-primary">
                                            <i class="fas fa-image"></i>
                                        </span>
                                        <input type="file" name="Imagen" id="Imagen" class="form-control border-primary" />
                                    </div>
                                    <small class="text-muted">Seleccione una imagen para el producto</small>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-4 d-flex gap-3 justify-content-center">
                            <button type="submit" class="btn btn-primary btn-lg px-5 shadow">
                                <i class="fas fa-save me-2"></i>Crear Producto
                            </button>
                            @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary btn-lg px-4" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}