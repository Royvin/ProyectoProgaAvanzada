@model ProyectoPograAvanzada.Models.Pedidos
@{
    ViewBag.Title = "Detalles del Pedido";
    var items = ViewBag.Items as List<ProyectoPograAvanzada.Models.PedidoItem>;
    decimal total = 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-primary bg-gradient text-white p-4">
                    <h2 class="text-center mb-0">
                        <i class="fas fa-clipboard-list me-2"></i>Detalles del Pedido #@Model.IdPedido
                    </h2>
                </div>

                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-8 mx-auto">
                            <div class="card shadow-sm border-top border-primary border-2 rounded-3">
                                <div class="card-header bg-primary bg-opacity-10 py-3">
                                    <h4 class="mb-0 text-primary text-center">
                                        <i class="fas fa-info-circle me-2"></i>Información del Pedido
                                    </h4>
                                </div>
                                <div class="card-body p-4">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <p><strong>Número de Pedido:</strong> <span class="badge bg-primary rounded-pill">@Model.IdPedido</span></p>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <p><strong>Fecha de Compra:</strong> <span class="text-muted">@Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</span></p>
                                        </div>
                                    </div>
                                    <p class="mb-0">
                                        <strong>Estado:</strong>
                                        @{
                                            string badgeClass = "bg-warning text-dark";
                                            if (Model.Estado == "Entregado") { badgeClass = "bg-success"; }
                                            else if (Model.Estado == "Cancelado") { badgeClass = "bg-danger"; }
                                        }
                                        <span class="badge @badgeClass rounded-pill px-3 py-2">@Model.Estado</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h3 class="text-primary mb-3 text-center">
                        <i class="fas fa-book me-2"></i>Productos
                    </h3>

                    <div class="table-responsive">
                        <table class="table table-hover border rounded-3 overflow-hidden shadow-sm">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th class="py-3">Producto</th>
                                    <th class="py-3">Precio</th>
                                    <th class="py-3">Cantidad</th>
                                    <th class="py-3">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in items)
                                {
                                    total += item.Total;
                                    <tr>
                                        <td class="align-middle py-3">@item.Nombre</td>
                                        <td class="align-middle py-3">$@item.Precio.ToString("N2")</td>
                                        <td class="align-middle py-3">@item.Cantidad</td>
                                        <td class="align-middle py-3 fw-bold">$@item.Total.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td colspan="3" class="text-end py-3"><strong>Total del Pedido:</strong></td>
                                    <td class="py-3 fw-bold fs-5 text-primary">$@total.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="d-flex justify-content-center mt-4 gap-3">
                        @Html.ActionLink("Volver a la Lista", "Index", null, new { @class = "btn btn-outline-secondary btn-lg px-4" })
                        @Html.ActionLink("Volver a Productos", "Index", "Productoes", null, new { @class = "btn btn-primary btn-lg px-4" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>