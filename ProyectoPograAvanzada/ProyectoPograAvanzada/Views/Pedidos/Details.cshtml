@model ProyectoPograAvanzada.Models.Pedidos
@{
    ViewBag.Title = "Detalles del Pedido";
    var items = ViewBag.Items as List<ProyectoPograAvanzada.Models.PedidoItem>;
    decimal total = 0;
}

<h2 class="text-center text-success">Detalles del Pedido #@Model.IdPedido</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <h4>Información del Pedido</h4>
            </div>
            <div class="card-body">
                <p><strong>Número de Pedido:</strong> @Model.IdPedido</p>
                <p><strong>Fecha de Compra:</strong> @Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Estado:</strong> @Model.Estado</p>
            </div>
        </div>
    </div>
</div>

<h3>Productos</h3>

<table class="table table-striped table-hover">
    <thead class="table-success">
        <tr>
            <th>Producto</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in items)
        {
            total += item.Total;
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Precio</td>
                <td>@item.Cantidad</td>
                <td>@item.Total</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-right"><strong>Total del Pedido:</strong></td>
            <td><strong>@total</strong></td>
        </tr>
    </tfoot>
</table>

<div class="text-center mt-3">
    @Html.ActionLink("Volver a la Lista", "Index", null, new { @class = "btn btn-success" })
    @Html.ActionLink("Volver a Productos", "Index", "Productoes", null, new { @class = "btn btn-primary" })
</div>