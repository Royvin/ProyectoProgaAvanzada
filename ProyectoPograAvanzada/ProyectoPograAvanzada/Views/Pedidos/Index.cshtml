@model IEnumerable<ProyectoPograAvanzada.Models.Pedidos>
@{
    ViewBag.Title = "Lista de Pedidos";
}

<h2 class="text-center text-success">Lista de Pedidos</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-success">
        <tr>
            <th>ID Pedido</th>
            <th>Fecha de Compra</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdPedido</td>
                <td>@item.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Estado</td>
                <td>
                    @Html.ActionLink("Detalles", "Details", new { id = item.IdPedido }, new { @class = "btn btn-info btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>