@model IEnumerable<ProyectoPograAvanzada.Models.Pedidos>
@{
    ViewBag.Title = "Lista de Pedidos";
}

<h2 class="text-center text-success">Lista de Pedidos</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-success">
        <tr>
            <th>ID Pedido</th>
            <th>Fecha de Compra</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdPedido</td>
                <td>@item.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <form action="@Url.Action("ActualizarEstado", "Pedidos")" method="post" class="d-flex align-items-center">
                        <input type="hidden" name="pedidoId" value="@item.IdPedido" />
                        <select name="nuevoEstado" class="form-control form-control-sm" onchange="this.form.submit()" style="width: auto;">
                            <option value="Pendiente" @(item.Estado == "Pendiente" ? "selected" : "")>Pendiente</option>
                            <option value="Entregado" @(item.Estado == "Entregado" ? "selected" : "")>Entregado</option>
                            <option value="Cancelado" @(item.Estado == "Cancelado" ? "selected" : "")>Canceelado</option>
                        </select>
                    </form>
                </td>
                <td>
                    <div class="btn-group">
                        @Html.ActionLink("Detalles", "Details", new { id = item.IdPedido }, new { @class = "btn btn-info btn-sm" })
                        @if (item.Estado != "Entregado")
                        {
                            @Html.ActionLink("Editar", "Edit", new { id = item.IdPedido }, new { @class = "btn btn-warning btn-sm" })
                            @Html.ActionLink("Eliminar", "Delete", new { id = item.IdPedido }, new { @class = "btn btn-danger btn-sm" })
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center mt-3">
    @Html.ActionLink("Volver a Productos", "Index", "Productoes", null, new { @class = "btn btn-primary" })
</div>

<script>
    // Agregar confirmación al cambiar a "Entregado"
    document.addEventListener('DOMContentLoaded', function () {
        var selects = document.querySelectorAll('select[name="nuevoEstado"]');
        selects.forEach(function (select) {
            select.addEventListener('change', function (e) {
                if (this.value === 'Entregado' && this.options[0].selected === false) {
                    if (!confirm('¿Estás seguro de marcar este pedido como entregado? Esta acción reducirá el inventario y no se puede deshacer fácilmente.')) {
                        e.preventDefault();
                        // Restaurar el valor anterior
                        this.value = this.options[0].value;
                        return false;
                    }
                }
            });
        });
    });
</script>