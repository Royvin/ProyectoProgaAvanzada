@model ProyectoPograAvanzada.Models.Pedidos
@{
    ViewBag.Title = "Editar Pedido";
    var items = ViewBag.Items as List<ProyectoPograAvanzada.Models.PedidoItem>;
    decimal total = 0;
}

<h2 class="text-center text-success">Editar Pedido #@Model.IdPedido</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <h4>Error</h4>
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <h4>Error</h4>
        <p>@TempData["Error"]</p>
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.IdPedido)
    @Html.HiddenFor(model => model.idCarrito)
    @Html.HiddenFor(model => model.FechaCompra)

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header bg-success text-white">
                    <h4>Información del Pedido</h4>
                </div>
                <div class="card-body">
                    <p><strong>Número de Pedido:</strong> @Model.IdPedido</p>
                    <p><strong>Fecha de Compra:</strong> @Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</p>
                    <div class="form-group">
                        <label for="Estado"><strong>Estado:</strong></label>
                        @Html.DropDownList("Estado", new SelectList(ViewBag.Estados, "Value", "Text", Model.Estado), new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h3>Productos</h3>

    <table class="table table-striped table-hover">
        <thead class="table-success">
            <tr>
                <th>Producto</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < items.Count; i++)
            {
                var item = items[i];
                total += item.Total;
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Precio</td>
                    <td>
                        <input type="number" name="itemCantidad[@item.Id]" value="@item.Cantidad" min="1" class="form-control form-control-sm cantidad-input" data-precio="@item.Precio" data-row="@i" style="width: 80px;" />
                    </td>
                    <td class="total-item">@item.Total</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-right"><strong>Total del Pedido:</strong></td>
                <td id="total-pedido"><strong>@total</strong></td>
            </tr>
        </tfoot>
    </table>

    <div class="text-center mt-3">
        <input type="submit" value="Guardar Cambios" class="btn btn-success" />
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Actualizar totales cuando cambie la cantidad
        var cantidadInputs = document.querySelectorAll('.cantidad-input');
        cantidadInputs.forEach(function (input) {
            input.addEventListener('change', function () {
                actualizarTotales();
            });
        });

        function actualizarTotales() {
            var total = 0;
            cantidadInputs.forEach(function (input) {
                var precio = parseFloat(input.dataset.precio);
                var cantidad = parseInt(input.value);
                var subtotal = precio * cantidad;

                // Actualizar el total de la fila
                var row = input.dataset.row;
                var totalItem = document.querySelectorAll('.total-item')[row];
                totalItem.textContent = subtotal.toFixed(2);

                total += subtotal;
            });

            // Actualizar el total del pedido
            document.getElementById('total-pedido').textContent = total.toFixed(2);
        }

        // Confirmar cambio a entregado
        var estadoSelect = document.getElementById('Estado');
        estadoSelect.addEventListener('change', function () {
            if (this.value === 'Entregado' && this.options[0].selected === false) {
                if (!confirm('¿Estás seguro de cambiar el estado a Entregado? Esta acción reducirá el inventario y no se puede deshacer fácilmente.')) {
                    this.value = 'Pendiente';
                }
            }
        });
    });
</script>