@model ProyectoPograAvanzada.Models.Pedidos
@{
    ViewBag.Title = "Editar Pedido";
    var items = ViewBag.Items as List<ProyectoPograAvanzada.Models.PedidoItem>;
    decimal total = 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-primary bg-gradient text-white p-4">
                    <h2 class="text-center mb-0">
                        <i class="fas fa-edit me-2"></i>Editar Pedido #@Model.IdPedido
                    </h2>
                </div>

                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3 shadow-sm">
                            <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i>Error</h5>
                            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-0 list-unstyled" })
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger rounded-3 shadow-sm">
                            <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i>Error</h5>
                            <p class="mb-0">@TempData["Error"]</p>
                        </div>
                    }

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.IdPedido)
                        @Html.HiddenFor(model => model.idCarrito)
                        @Html.HiddenFor(model => model.FechaCompra)

                        <div class="card shadow-sm rounded-3 mb-4 border-primary border-top border-0 border-2">
                            <div class="card-header bg-primary bg-opacity-10 py-3">
                                <h4 class="mb-0 text-primary">
                                    <i class="fas fa-info-circle me-2"></i>Información del Pedido
                                </h4>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <p><strong>Número de Pedido:</strong> <span class="badge bg-primary rounded-pill">@Model.IdPedido</span></p>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <p><strong>Fecha de Compra:</strong> <span class="text-muted">@Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</span></p>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="Estado" class="form-label"><strong>Estado:</strong></label>
                                    @Html.DropDownList("Estado", new SelectList(ViewBag.Estados, "Value", "Text", Model.Estado), new { @class = "form-select form-select-lg" })
                                </div>
                            </div>
                        </div>

                        <h3 class="text-primary mb-3">
                            <i class="fas fa-boxes me-2"></i>Productos
                        </h3>

                        <div class="table-responsive">
                            <table class="table table-hover border rounded-3 overflow-hidden shadow-sm">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th class="py-3">Producto</th>
                                        <th class="py-3">Precio</th>
                                        <th class="py-3">Cantidad</th>
                                        <th class="py-3">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < items.Count; i++)
                                    {
                                        var item = items[i];
                                        total += item.Total;
                                        <tr>
                                            <td class="align-middle py-3">@item.Nombre</td>
                                            <td class="align-middle py-3">@item.Precio.ToString("C")</td>
                                            <td class="align-middle py-3">
                                                <div class="input-group">
                                                    <span class="input-group-text bg-primary text-white border-0">
                                                        <i class="fas fa-hashtag"></i>
                                                    </span>
                                                    <input type="number" name="itemCantidad[@item.Id]" value="@item.Cantidad" min="1"
                                                           class="form-control cantidad-input border-primary"
                                                           data-precio="@item.Precio" data-row="@i" />
                                                </div>
                                            </td>
                                            <td class="align-middle py-3 total-item fw-bold">@item.Total.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-light">
                                    <tr>
                                        <td colspan="3" class="text-end py-3"><strong>Total del Pedido:</strong></td>
                                        <td id="total-pedido" class="py-3 fw-bold fs-5 text-primary">@total.ToString("C")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="text-center mt-4 d-flex gap-3 justify-content-center">
                            <button type="submit" class="btn btn-primary btn-lg px-5 shadow">
                                <i class="fas fa-save me-2"></i>Guardar Cambios
                            </button>
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary btn-lg px-5" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var cantidadInputs = document.querySelectorAll('.cantidad-input');
        cantidadInputs.forEach(function (input) {
            input.addEventListener('change', function () {
                actualizarTotales();
            });
        });

        function actualizarTotales() {
            var total = 0;
            cantidadInputs.forEach(function (input) {
                var precio = parseFloat(input.dataset.precio);
                var cantidad = parseInt(input.value);
                var subtotal = precio * cantidad;
                var row = input.dataset.row;
                var totalItem = document.querySelectorAll('.total-item')[row];
                totalItem.textContent = '$' + subtotal.toFixed(2);
                total += subtotal;
            });
            document.getElementById('total-pedido').textContent = '$' + total.toFixed(2);
        }

        var estadoSelect = document.getElementById('Estado');
        estadoSelect.addEventListener('change', function () {
            if (this.value === 'Entregado') {
                if (!confirm('¿Estás seguro de cambiar el estado a Entregado? Esta acción reducirá el inventario y no se puede deshacer fácilmente.')) {
                    this.value = 'Pendiente';
                }
            }
        });
    });
</script>