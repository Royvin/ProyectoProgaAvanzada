@model IEnumerable<ProyectoPograAvanzada.Models.UserRoleViewModel>

@{
    ViewBag.Title = "Administración de Roles";
}

<h2>Administración de Roles</h2>
<table class="table">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Rol</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.RoleName</td>
                <td>
                    <a href="@Url.Action("AssignRole", "UserRole", new { id = user.UserId })" class="btn btn-primary">Asignar Rol</a>
                    <a href="@Url.Action("RemoveRole", "UserRole", new { id = user.UserId })" class="btn btn-danger">Eliminar Rol</a>
                </td>
            </tr>
        }
    </tbody>
</table>
