@model ProyectoPograAvanzada.Models.RegisterViewModel
@{
    ViewBag.Title = "Registrarse";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-primary bg-gradient text-white p-4">
                    <h2 class="text-center mb-0">
                        <i class="fas fa-user-plus me-2"></i>@ViewBag.Title
                    </h2>
                </div>

                <div class="card-body p-4">
                    @if (ViewData.ModelState.Any(x => x.Value.Errors.Any()))
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@Html.ValidationSummary("", new { @class = "text-danger" })
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            <div class="p-3">
                                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form", @class = "mt-3" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <h4 class="mb-3 text-primary">
                                        <i class="fas fa-user-edit me-2"></i>Cree una cuenta nueva
                                    </h4>
                                    <hr class="mb-4" />

                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label for="Email" class="form-label fw-bold">
                                                <i class="fas fa-envelope me-2"></i>@Html.DisplayNameFor(m => m.Email)
                                            </label>
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control shadow-sm rounded-pill", placeholder = "ejemplo@correo.com" })
                                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label for="NombreCompleto" class="form-label fw-bold">
                                                <i class="fas fa-user me-2"></i>@Html.DisplayNameFor(m => m.NombreCompleto)
                                            </label>
                                            @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control shadow-sm rounded-pill", placeholder = "Nombre y Apellidos" })
                                            @Html.ValidationMessageFor(m => m.NombreCompleto, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="PhoneNumber" class="form-label fw-bold">
                                            <i class="fas fa-phone me-2"></i>@Html.DisplayNameFor(m => m.PhoneNumber)
                                        </label>
                                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control shadow-sm rounded-pill", placeholder = "Teléfono de contacto" })
                                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label for="Password" class="form-label fw-bold">
                                                <i class="fas fa-lock me-2"></i>@Html.DisplayNameFor(m => m.Password)
                                            </label>
                                            @Html.PasswordFor(m => m.Password, new { @class = "form-control shadow-sm rounded-pill", placeholder = "Contraseña" })
                                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label for="ConfirmPassword" class="form-label fw-bold">
                                                <i class="fas fa-lock me-2"></i>@Html.DisplayNameFor(m => m.ConfirmPassword)
                                            </label>
                                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control shadow-sm rounded-pill", placeholder = "Confirme su contraseña" })
                                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="d-grid gap-2 mb-4 mt-4">
                                        <button type="submit" class="btn btn-primary btn-lg shadow rounded-pill">
                                            <i class="fas fa-user-plus me-2"></i>Registrarse
                                        </button>
                                    </div>

                                    <hr class="my-4" />

                                    <div class="text-center">
                                        <p class="mb-2">
                                            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary rounded-pill px-4">
                                                <i class="fas fa-sign-in-alt me-2"></i>¿Ya tienes cuenta? Inicia sesión
                                            </a>
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}